# Copy to backend/.env and fill in. backend/.env is git-ignored.

# --- Required ---------------------------------------------------------------
MONGO_URL=mongodb://localhost:27017
DB_NAME=bookloop

# --- File storage -----------------------------------------------------------
# Uploaded images are stored on disk. Default: backend/uploads. In production point this at a
# persistent volume and back it up together with the database.
# STORAGE_DIR=/var/lib/bookloop/uploads

# --- Signed image links -----------------------------------------------------
# Optional. If unset, a random secret is generated once and stored in MongoDB.
# FILE_SIGNING_SECRET=

# --- Google sign-in ---------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> Create credentials -> OAuth client ID
# -> Application type: "Web application".
#   Authorized redirect URI:  <PUBLIC_BACKEND_URL>/api/auth/google/callback
# Google only accepts https redirect URIs (plus http://localhost), so for a phone on your LAN use an
# https tunnel (e.g. cloudflared or ngrok) and put its address in PUBLIC_BACKEND_URL.
# Without GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET the Google button is hidden in the app.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# PUBLIC_BACKEND_URL=https://api.example.com

# Where the app may be sent back to after Google. Only these EXACT return URLs are accepted:
#   <scheme>://  and  <scheme>://settings/account   for every APP_URL_SCHEMES entry (default: bookloop,
#                                                    the "scheme" from frontend/app.json)
#   <origin>/    and  <origin>/settings/account      for every APP_REDIRECT_ORIGINS entry (web builds)
# APP_URL_SCHEMES=bookloop
# APP_REDIRECT_ORIGINS=https://app.example.com
#
# Local development ONLY (Expo Go exp://, development builds, http://localhost / 127.0.0.1 on any
# port). Never set this on a backend reachable from the internet: those return addresses can belong to
# someone other than the person signing in.
# ALLOW_DEV_REDIRECTS=1
#
# Kill switch for the browser flow returning to the app's URL scheme(s) (APP_URL_SCHEMES). Any app on a
# phone can claim a custom scheme, so set this to 0 once the app signs in with native Google sign-in
# (below) and older builds are gone (scripts/client_versions.py): the browser flow then only returns to
# APP_REDIRECT_ORIGINS. Default 1 (on).
# GOOGLE_WEB_FLOW_APP_SCHEMES=1
#
# Native Google sign-in on Android (Credential Manager). Google Cloud Console -> Credentials -> Create
# OAuth client ID -> Android: package name com.otabekceo.bookloop + the SHA-1 of each signing key (EAS
# build keystore; later also the Play app signing key), in the SAME project as GOOGLE_CLIENT_ID. List
# those Android client IDs here (comma-separated). The app requests the ID token for GOOGLE_CLIENT_ID.
# Unset = native Google sign-in is off. Needs PyJWT[crypto] (requirements.txt).
# GOOGLE_ANDROID_CLIENT_IDS=1234567890-abc.apps.googleusercontent.com

# --- Sign in with Apple (iOS) -------------------------------------------------
# The iOS bundle identifier(s) Apple puts in the identity token's `aud` (frontend/app.json ios.bundleIdentifier).
# Needs `pip install PyJWT[crypto]` (in requirements.txt). Unset = Apple sign-in is off and hidden in the app.
# No Apple secret/private key is needed: the backend only verifies Apple's signed identity token.
# APPLE_BUNDLE_IDS=com.otabekceo.bookloop

# --- Transactional email (registration OTP) ---------------------------------
# Sign up at resend.com, create an API key (Settings -> API Keys) and put it here.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# The "from" address emails are sent as. Without a verified domain (resend.com/domains), Resend's
# shared onboarding@resend.dev address only delivers to the Resend account's own signup email — fine
# for solo development, not for real users. Verify a domain before going further than that.
# EMAIL_FROM=BookLoop <onboarding@resend.dev>
# Without RESEND_API_KEY set, /api/auth/register/request-otp fails clearly (503) telling you what to
# configure, UNLESS OTP_DEBUG_MODE is also on (see below) — the app never silently "pretends" to send.

# --- OTP debug mode (development/testing only) ------------------------------
# When true: OTP codes are echoed back in request-otp/resend-otp API responses (debug_otp field), and
# a test-only /api/auth/register/dev-instant endpoint appears (instant account creation, bypassing
# OTP — used by the automated test suite's fixtures). NEVER set this to true on a backend reachable
# from the internet (e.g. behind a tunnel or in production) — it lets anyone read OTP codes and skip
# email verification entirely. Leave unset for a normal run; only export it inline for a test run:
#   OTP_DEBUG_MODE=true python -m uvicorn server:app --port 8001   (bash)
#   $env:OTP_DEBUG_MODE='true'; python -m uvicorn server:app --port 8001   (PowerShell)
# OTP_DEBUG_MODE=false

# --- Demo community -----------------------------------------------------------
# 10 made-up readers with swaps and reviews, for local development and screenshots ONLY.
# Never enable on a real server (fake people and reviews would mix with real ones).
# To remove an existing demo community: python scripts/remove_demo_community.py --yes
# SEED_DEMO_COMMUNITY=1

# --- Book metadata (search aliases) ----------------------------------------------
# Background lookups of alternate titles/author spellings for search (OpenLibrary + Wikidata).
# Wikidata requires contact details in the User-Agent: set an operator email or URL to enable it.
# METADATA_CONTACT=support@your-domain.example
# METADATA_ENRICH=0          # turn all metadata lookups off
