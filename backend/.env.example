# Copy to backend/.env and fill in. backend/.env is git-ignored.

# --- Required ---------------------------------------------------------------
MONGO_URL=mongodb://localhost:27017
DB_NAME=bookloop

# --- File storage -----------------------------------------------------------
# Uploaded images are stored on disk. Default: backend/uploads. In production point this at a
# persistent volume and back it up together with the database.
# STORAGE_DIR=/var/lib/bookloop/uploads

# --- Signed image links -----------------------------------------------------
# Optional. If unset, a random secret is generated once and stored in MongoDB.
# FILE_SIGNING_SECRET=

# --- Google sign-in ---------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> Create credentials -> OAuth client ID
# -> Application type: "Web application".
#   Authorized redirect URI:  <PUBLIC_BACKEND_URL>/api/auth/google/callback
# Google only accepts https redirect URIs (plus http://localhost), so for a phone on your LAN use an
# https tunnel (e.g. cloudflared or ngrok) and put its address in PUBLIC_BACKEND_URL.
# Without GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET the Google button is hidden in the app.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# PUBLIC_BACKEND_URL=https://api.example.com

# Where the app may be sent back to after Google. Always allowed: http://localhost and
# http://127.0.0.1 (any port). Add your deployed web origin(s) and the app's URL scheme(s).
# APP_REDIRECT_ORIGINS=https://app.example.com
# APP_URL_SCHEMES=exp,exps,bookloop   # must include the "scheme" from frontend/app.json

# --- Transactional email (registration OTP) ---------------------------------
# Sign up at resend.com, create an API key (Settings -> API Keys) and put it here.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# The "from" address emails are sent as. Without a verified domain (resend.com/domains), Resend's
# shared onboarding@resend.dev address only delivers to the Resend account's own signup email — fine
# for solo development, not for real users. Verify a domain before going further than that.
# EMAIL_FROM=BookLoop <onboarding@resend.dev>
# Without RESEND_API_KEY set, /api/auth/register/request-otp fails clearly (503) telling you what to
# configure, UNLESS OTP_DEBUG_MODE is also on (see below) — the app never silently "pretends" to send.

# --- OTP debug mode (development/testing only) ------------------------------
# When true: OTP codes are echoed back in request-otp/resend-otp API responses (debug_otp field), and
# a test-only /api/auth/register/dev-instant endpoint appears (instant account creation, bypassing
# OTP — used by the automated test suite's fixtures). NEVER set this to true on a backend reachable
# from the internet (e.g. behind a tunnel or in production) — it lets anyone read OTP codes and skip
# email verification entirely. Leave unset for a normal run; only export it inline for a test run:
#   OTP_DEBUG_MODE=true python -m uvicorn server:app --port 8001   (bash)
#   $env:OTP_DEBUG_MODE='true'; python -m uvicorn server:app --port 8001   (PowerShell)
# OTP_DEBUG_MODE=false
