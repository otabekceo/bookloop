# Copy to frontend/.env (git-ignored). Restart Metro with `npx expo start -c` after changing it.
#
# Address of the BookLoop backend as reachable from the device running the app:
#   - phone on your Wi-Fi/hotspot:  http://<your PC's LAN IP>:8001   (run `ipconfig`)
#   - Android emulator:             http://10.0.2.2:8001
#   - web / iOS simulator:          http://localhost:8001
#   - production:                   https://api.your-domain.example
# Google sign-in additionally needs an https address (see backend/.env.example).
EXPO_PUBLIC_BACKEND_URL=http://192.168.1.10:8001
