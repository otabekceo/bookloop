# Copy to frontend/.env (git-ignored). Restart Metro with `npx expo start -c` after changing it.
#
# Address of the BookLoop backend as reachable from the device running the app:
#   - phone on your Wi-Fi/hotspot:  http://<your PC's LAN IP>:8001   (run `ipconfig`)
#   - Android emulator:             http://10.0.2.2:8001
#   - web / iOS simulator:          http://localhost:8001
#   - production:                   https://api.your-domain.example
# Google sign-in additionally needs an https address (see backend/.env.example).
EXPO_PUBLIC_BACKEND_URL=http://192.168.1.10:8001

# Native Google sign-in on Android (Credential Manager): the backend's OAuth client of type "Web
# application" — the SAME value as GOOGLE_CLIENT_ID in backend/.env — NOT the Android OAuth client.
# A client ID is a public identifier; never put a client secret (or any other secret) in EXPO_PUBLIC_*.
# Unset = the app keeps using the browser Google flow. Only takes effect in a development/EAS build (not
# Expo Go) and only when the backend has native sign-in on (GOOGLE_ANDROID_CLIENT_IDS set).
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123456789012-abcdefghijklmnop.apps.googleusercontent.com
