{
  "expo": {
    "name": "BookLoop",
    "slug": "bookloop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bookloop",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.otabekceo.bookloop",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Add book covers and profile photos",
        "NSCameraUsageDescription": "Scan book barcodes and take cover photos",
        "NSLocationWhenInUseUsageDescription": "BookLoop uses your location to show readers and books near you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F7F4EE"
      },
      "package": "com.otabekceo.bookloop",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/bookloop-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F7F4EE"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Add book covers and profile photos",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan book barcodes and take cover photos",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BookLoop uses your location to show readers and books near you.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "44634212-ed7f-4589-b153-470ac7db2fa7"
      }
    },
    "owner": "otabekceo"
  }
}
