{
  "expo": {
    "name": "BookLoop",
    "slug": "bookloop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bookloop",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.otabekceo.bookloop",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Add book covers and profile photos",
        "NSCameraUsageDescription": "Scan book barcodes and take cover photos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F7F4EE"
      },
      "package": "com.otabekceo.bookloop",
      "permissions": ["READ_MEDIA_IMAGES", "CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#17211F"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Add book covers and profile photos"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan book barcodes and take cover photos"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}